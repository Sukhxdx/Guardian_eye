# Copy to .env and fill in. Do not commit .env.

# Optional Hugging Face model repo that holds trained weights.
# Leave empty to run with local files under models/ (or with no weights).
HF_MODEL_REPO=

# Only required for private Hub repos.
HF_TOKEN=

# Server
GUARDIANEYE_HOST=0.0.0.0
GUARDIANEYE_PORT=8742
GUARDIANEYE_DB=data/events.sqlite

# Set to 1 to skip mounting the Gradio dashboard (API only).
GUARDIANEYE_NO_UI=0
